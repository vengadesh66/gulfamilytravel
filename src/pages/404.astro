---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn't exist. Head back to our family holiday guides from Dubai." noindex ogType="website">
  <section class="container section not-found">
    <p class="eyebrow">404</p>
    <h1>This trip doesn't exist (yet)</h1>
    <p class="lede">The page you're looking for has moved or was never booked. Try one of these instead:</p>
    <ul>
      <li><a href="/">Best family holidays from Dubai 2026</a></li>
      <li><a href="/bali-family-trip-from-dubai">Bali family trip from Dubai</a></li>
      <li><a href="/#visa-free-for-indians">Visa-free destinations for Indians</a></li>
    </ul>
  </section>
</Base>

<style>
  .not-found {
    min-height: 50vh;
  }
  .not-found h1 {
    margin-block: var(--space-xs) var(--space-m);
  }
  .not-found ul {
    margin-top: var(--space-l);
  }
</style>
